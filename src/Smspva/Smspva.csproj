<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Smspva.Sdk</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Description>Official C# and .NET SDK for SMSPVA SMS activation, phone number rental and private email rental APIs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <Authors>SMSPVA</Authors>
    <Title>SMSPVA .NET SDK</Title>
    <PackageProjectUrl>https://smspva.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMSPVA/smspva-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>smspva;sms;verification;activation;phone-number;rental;email;sdk</PackageTags>
    <PackageReleaseNotes>First public alpha covering all 56 Activation V2, Rental and Private Email operations.</PackageReleaseNotes>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageOutputPath>../../artifacts</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="contracts.json" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
